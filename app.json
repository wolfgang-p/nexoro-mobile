{
  "expo": {
    "name": "Nexoro Work",
    "slug": "nexoro-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-new.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.nexoro.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-new.png",
        "backgroundColor": "#ffffff"
      },
      "package": "net.nexoro.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "741081b3-8dfc-445f-9720-2d764fb4e2e7"
      }
    }
  }
}
